schema_version: 3
id: internvla_maas
execution:
  mode: async
  call_every_actions: 1
  control_mode: qpos
  on_backend_switch: reinitialize_policy
params:
  model_config_path: model.json
hot_reloadable:
- execution.mode
- execution.call_every_actions
- execution.on_backend_switch
tui_commands:
  switch-model:
    handler: switch_model
    args: [str]
    help: 校验独立 MaaS 配置并冷重载本实例；成功后等待 resume
    timeout_s: 30
    effect: reload_policy
