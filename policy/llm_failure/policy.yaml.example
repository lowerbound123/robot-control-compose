schema_version: 3
id: llm_failure
execution:
  mode: async
  call_every_actions: 1
  control_mode: qpos
params:
  check_every_steps: 60
  history_size: 5
  image_max_side: 1024
  jpeg_quality: 85
  provider_config_path: provider.yaml
hot_reloadable: []
tui_commands:
  switch-provider:
    handler: switch_provider
    args: [str]
    help: 校验供应商配置文件并冷重载，完成后等待 resume
    timeout_s: 30
    effect: reload_policy
