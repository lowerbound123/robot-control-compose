schema_version: 3
id: example
execution:
  mode: sync
  call_every_actions: 1
  control_mode: qpos
  on_backend_switch: reinitialize_policy
params:
  message: example
  reset_token: 0     # config set 修改此标记后清空统计和待发结果，保留 context
  log_every_n_calls: 100
  chunk_size: 1       # 仅空输入时生成；config set 会在原进程重新初始化
  inference_delay_s: 0.0  # 显式模拟慢推理，便于观察 sync / async 的缓存消费
  reader_url: ''      # 选填：能与 RC 共享 POSIX IPC 的演示 reader，默认不联网
hot_reloadable:
- params.message
- params.log_every_n_calls
- params.inference_delay_s
- execution.on_backend_switch
tui_commands:
  set-message:
    handler: set_message
    args: [{name: message, type: str, help: 消息文本}]
    help: 热更新本实例的消息，保留 context 和执行进程
    effect: update_config
    timeout_s: 5
  example:
    handler: example
    args: []
    help: 查看 example 的统计、图像摘要、运行时元数据和当前配置
    timeout_s: 5
  next-result:
    handler: next_result
    args: [{name: outcome, type: enum, help: 下一次推理的控制结果, choices: [pause,
            completed, terminated, fault]}, {name: message, type: str, help:
          结果说明}]
    help: 运行中让下一次推理暂停、报告完成/终止或演示故障：pause/completed/terminated/fault 和说明
    timeout_s: 5
  shared-read:
    handler: shared_read
    args: []
    help: 读取共享键 example_note 及当前版本
    timeout_s: 5
  shared-write:
    handler: shared_write
    args: [{name: value, type: str, help: 共享字段内容}, {name: version, type: int,
          help: 期望的共享状态版本}]
    help: 按给定版本写入 example_note（消息 版本）
    timeout_s: 5
  set-chunk-size:
    handler: set_chunk_size
    args: [{name: size, type: int, help: 动作块长度}]
    help: 只重载本实例，将空输入保持的帧数设为 1 到 256
    effect: reload_policy
    timeout_s: 5
  set-chunk-size-all:
    handler: set_chunk_size
    args: [{name: size, type: int, help: 动作块长度}]
    help: 修改本实例的保持帧数，并冷重载整个运行组
    effect: reload_all_policy
    timeout_s: 5
  reinitialize:
    handler: reinitialize
    args: []
    help: 用当前配置在原进程重新初始化本实例
    effect: reinitialize_policy
  reinitialize-chunk-size:
    handler: set_chunk_size
    args: [{name: size, type: int, help: 动作块长度}]
    help: 在原进程重新初始化本实例，同时设置空输入保持帧数
    effect: reinitialize_policy
config_hints:
  help: 修改当前实例配置；提示仅作辅助，输入仍由策略解析
  settings:
    params.message:
      type: str
      help: 消息文本
    params.reset_token:
      type: int
      help: 重置标记；修改后清空统计和待发结果并暂停
    params.log_every_n_calls:
      type: int
      help: 日志输出间隔（调用次数）
    params.chunk_size:
      type: int
      help: 输出动作块长度
    params.inference_delay_s:
      type: float
      help: 模拟推理延迟（秒）
    params.reader_url:
      type: str
      help: 外部图像 reader 服务地址
    execution.mode:
      type: enum
      choices:
      - sync
      - async
      help: 推理调度模式
    execution.call_every_actions:
      type: int
      help: 每次调用之间的动作数
    execution.control_mode:
      type: enum
      choices:
      - qpos
      - epos
      - mixed
      help: 动作坐标模式；修改后重新初始化并暂停
    execution.tui_command_workers:
      type: int
      help: 命令执行线程数；修改后重新初始化并暂停
