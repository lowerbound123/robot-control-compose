schema_version: 3
id: example
execution:
  mode: sync
  call_every_actions: 1
  control_mode: qpos
params:
  message: example
  log_every_n_calls: 100
  chunk_size: 1       # 仅空输入时生成；冷配置
  inference_delay_s: 0.0  # 显式模拟慢推理，便于观察 sync / async 的缓存消费
  reader_url: ''      # 选填：能与 RC 共享 POSIX IPC 的演示 reader，默认不联网
hot_reloadable:
  - params.message
  - params.log_every_n_calls
  - params.inference_delay_s
tui_commands:
  set-message:
    handler: set_message
    args: [str]
    help: 热更新本实例的消息，保留 context 和执行进程
    effect: update_config
    timeout_s: 5
  example:
    handler: example
    args: []
    help: 查看 example 的统计、图像摘要、运行时元数据和当前配置
    timeout_s: 5
  next-result:
    handler: next_result
    args: [str, str]
    help: 运行中让下一次推理暂停、报告完成/终止或演示故障：pause/completed/terminated/fault 和说明
    timeout_s: 5
  shared-read:
    handler: shared_read
    args: []
    help: 读取共享键 example_note 及当前版本
    timeout_s: 5
  shared-write:
    handler: shared_write
    args: [str, int]
    help: 按给定版本写入 example_note（消息 版本）
    timeout_s: 5
  set-chunk-size:
    handler: set_chunk_size
    args: [int]
    help: 只重载本实例，将空输入保持的帧数设为 1 到 256
    effect: reload_policy
    timeout_s: 5
  set-chunk-size-all:
    handler: set_chunk_size
    args: [int]
    help: 修改本实例的保持帧数，并冷重载整个运行组
    effect: reload_all_policy
    timeout_s: 5
  reinitialize:
    handler: reinitialize
    args: []
    help: 用当前配置在原进程重新初始化本实例
    effect: reinitialize_policy
  reinitialize-chunk-size:
    handler: set_chunk_size
    args: [int]
    help: 在原进程重新初始化本实例，同时设置空输入保持帧数
    effect: reinitialize_policy
