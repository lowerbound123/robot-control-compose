# Actual deployment configuration stays local; ship *.example templates.
/*.json
/*.yaml
/*.yml
/*.toml
/*.ini
/*.cfg
/*.conf
/configs/**/*.json
/configs/**/*.yaml
/configs/**/*.yml
/configs/**/*.toml
/configs/**/*.ini
/configs/**/*.cfg
/configs/**/*.conf
/policy/**/*.json
/policy/**/*.yaml
/policy/**/*.yml
/policy/**/*.toml
/policy/**/*.ini
/policy/**/*.cfg
/policy/**/*.conf
/connector/**/*.json
/connector/**/*.yaml
/connector/**/*.yml
/connector/**/*.toml
/connector/**/*.ini
/connector/**/*.cfg
/connector/**/*.conf

# Source layout, independent of policy/connector names. These directories own
# versioned code, schemas, provenance manifests and dependency build inputs.
!/compose.yaml
!/compose.yml
!/compose.*.yaml
!/compose.*.yml
!/pyproject.toml
!/policy/*/compose.yaml
!/policy/*/compose.yml
!/policy/*/compose.*.yaml
!/policy/*/compose.*.yml
!/policy/*/pyproject.toml
!/policy/*/src/**
!/policy/*/vendor/**
!/policy/*/dependencies/**
!/connector/*/compose.yaml
!/connector/*/compose.yml
!/connector/*/compose.*.yaml
!/connector/*/compose.*.yml
!/connector/*/pyproject.toml
!/connector/*/src/**
!/connector/*/vendor/**
!/connector/*/dependencies/**

# Machine overrides and secrets remain private, including inside source trees.
# Use compose.<name>.local.yaml/yml for site-specific Compose overrides.
*.local.*
compose.override.yaml
compose.override.yml
**/*.env
**/.env
**/.env.*
**/.global.env.*
/webui/config.json

# Keep runtime/build artifacts below source exceptions so they stay ignored.
.DS_Store
.codex/
/.setup/
.runtime/
.venv/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
outputs/
snapshot/
/models/
/cache/
ros_ws/build/
ros_ws/install/
ros_ws/log/
**/node_modules/
/webui/test-results/
/webui/playwright-report/

# Templates are source, including .env.example and *.local.yaml.example.
# This does not reinclude files beneath ignored artifact directories.
!**/*.example
