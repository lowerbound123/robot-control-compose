.DS_Store
.codex/
**/*.env
**/.env
**/.env.*
**/.global.env.*
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
outputs/
snapshot/
/models/
/cache/
ros_ws/build/
ros_ws/install/
ros_ws/log/

# Actual deployment configuration stays local; ship *.example templates.
/*.json
/*.yaml
/*.yml
/*.toml
/*.ini
/*.cfg
/*.conf
/configs/**/*.json
/configs/**/*.yaml
/configs/**/*.yml
/configs/**/*.toml
/configs/**/*.ini
/configs/**/*.cfg
/configs/**/*.conf
/policy/**/*.json
/policy/**/*.yaml
/policy/**/*.yml
/policy/**/*.toml
/policy/**/*.ini
/policy/**/*.cfg
/policy/**/*.conf
/connector/**/*.json
/connector/**/*.yaml
/connector/**/*.yml
/connector/**/*.toml
/connector/**/*.ini
/connector/**/*.cfg
/connector/**/*.conf
/.setup/
/policy/**/.runtime/

# Versioned build definitions and immutable model schemas are source assets.
!/compose.yaml
!/compose.acone.yaml
!/compose.ros-sim.yaml
!/compose.webui.yaml
!/pyproject.toml
!/policy/*/compose.yaml
!/policy/*/pyproject.toml
!/connector/*/compose.yaml
!/policy/*/vendor/pyproject.toml
!/policy/*/vendor/lerobot/dataset_schemas/configs/*.yaml
!/policy/qwen35_history/vendor/SOURCE_MANIFEST.json
!/policy/qwen35_history_lift2/vendor/SOURCE_MANIFEST.json
!/policy/qwen35_history_clip/vendor/SOURCE_MANIFEST.json
!**/*.example

# WebUI local credentials and build/test outputs
/webui/config.json
**/node_modules/
/webui/test-results/
/webui/playwright-report/
