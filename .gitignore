.DS_Store
.codex/
**/global.env
**/.global.env.*
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
outputs/
snapshot/
/models/
/cache/
/.env
/.env.local
/.env.llm
/.env.qwen
ros_ws/build/
ros_ws/install/
ros_ws/log/

# Local configuration and generated deployment artifacts
/rc*.json
/configs/**/*.json
/policy/**/*.json
/policy/**/.env
/.setup/
/connector/*/devices/*.yaml
/connector/*/devices/*.yml

/policy/**/.runtime/
/policy/**/deployment.env

# Private YAML main configurations; JSON business/legacy rules above remain.
/rc*.yaml
/rc*.yml
/configs/rc*.yaml
/configs/rc*.yml
/policy/*/policy.yaml
/policy/*/policy.yml

# Private LLM provider profiles (including custom names). Ship *.yaml.example.
/policy/llm_direction/**/*.yaml
/policy/llm_direction/**/*.yml
/policy/llm_failure/**/*.yaml
/policy/llm_failure/**/*.yml
!/policy/llm_direction/compose.yaml
!/policy/llm_failure/compose.yaml

# WebUI local credentials and build/test outputs
/webui/config.json
**/node_modules/
/webui/test-results/
/webui/playwright-report/
