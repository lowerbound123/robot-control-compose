{
  "schema_version": 2,
  "frequency_hz": 30,
  "policy_directory": "../policy",
  "startup_policy": "hold",
  "robot": {
    "backend": "acone",
    "namespace": "/robot_control_test",
    "feedback_left_topic": "/robot_control_test/feedback/left",
    "feedback_right_topic": "/robot_control_test/feedback/right",
    "command_left_topic": "/robot_control_test/command/left",
    "command_right_topic": "/robot_control_test/command/right",
    "camera_topics": {
      "head": "/robot_control_test/camera/head/compressed",
      "left_wrist": "/robot_control_test/camera/left_wrist/compressed",
      "right_wrist": "/robot_control_test/camera/right_wrist/compressed"
    },
    "feedback_timeout_s": 2,
    "camera_timeout_s": 2,
    "connect_timeout_s": 10,
    "close_timeout_s": 2,
    "feedback_message_type": "robot_control_test_msgs/msg/ArmState",
    "command_message_type": "robot_control_test_msgs/msg/ArmCommand"
  },
  "safety": {
    "enabled": true,
    "reference_frequency_hz": 50,
    "max_delta_per_step": [
      0.006072,
      0.018664,
      0.014556,
      0.009768,
      0.007063,
      0.008024,
      0.05,
      0.007601,
      0.012064,
      0.014512,
      0.011047,
      0.013188,
      0.009549,
      0.05
    ],
    "epos": {
      "translation_m_s": 0.15,
      "rotation_rad_s": 0.75,
      "gripper_units_s": 2.5
    }
  },
  "reset_qpos": [
    0,
    0,
    0,
    0,
    0,
    0,
    -5,
    0,
    0,
    0,
    0,
    0,
    0,
    -5
  ],
  "timeouts": {
    "initialize_s": 600,
    "inference_s": 60,
    "release_s": 30
  },
  "outputs_directory": "../outputs",
  "mcp": {
    "host": "127.0.0.1",
    "port": 4000,
    "token_env": "ROBOT_CONTROL_MCP_TOKEN"
  },
  "direct_control": {
    "default_speed": "slow",
    "gripper_open": -3.4,
    "gripper_close": 0,
    "gripper_tolerance": 0.12
  },
  "tui": {
    "camera": {
      "protocol": "kitty"
    },
    "monitor": {
      "qpos_thres": [
        0.02,
        0.02,
        0.02,
        0.02,
        0.02,
        0.02,
        0.12,
        0.02,
        0.02,
        0.02,
        0.02,
        0.02,
        0.02,
        0.12
      ],
      "epos_thres": [
        0.005,
        0.005,
        0.005,
        0.05,
        0.05,
        0.05,
        0.12,
        0.005,
        0.005,
        0.005,
        0.05,
        0.05,
        0.05,
        0.12
      ]
    }
  },
  "policy_hosts": {
    "hold": {
      "socket": "/run/robot-control/hold.sock"
    },
    "qwen35-single": {
      "socket": "/run/robot-control/qwen35-single.sock"
    },
    "qwen35-twostage": {
      "socket": "/run/robot-control/qwen35-twostage.sock"
    },
    "llm-direction": {
      "socket": "/run/robot-control/llm-direction.sock"
    }
  }
}
