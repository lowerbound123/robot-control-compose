# Merge into .env after setup-user.sh; keep RC_UID/RC_GID and ROS/MCP settings.
# Create custom model/cache directories as that user before starting Compose.
QWEN_SINGLE_GPU=0
QWEN_TWOSTAGE_GPU=0
QWEN_MODELS_DIR=./models
QWEN_HF_CACHE_DIR=./cache/huggingface
# Set to 1 only after all base-model/processor/tokenizer assets are cached.
QWEN_HF_HUB_OFFLINE=0
