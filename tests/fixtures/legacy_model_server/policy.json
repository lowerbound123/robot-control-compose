{
  "schema_version": 3,
  "id": "legacy_model_server",
  "conda_env": "rc-policy-model-server",
  "execution": {
    "mode": "sync",
    "call_every_actions": 1,
    "control_mode": "qpos"
  },
  "params": {
    "endpoint": "http://127.0.0.1:8000",
    "model_id": "mock",
    "load_overrides": {
      "model": {
        "chunk_size": 50
      }
    },
    "instruction": "Hold the current robot pose.",
    "mode": "sync",
    "request_when_remaining": 20,
    "image_transport": "shm",
    "continuous_observations": false,
    "fusion": {
      "trunk_mode": "close",
      "trunk_smoothing": true,
      "max_smoothing_steps": 5,
      "exponential_factor": 5.0,
      "exponential_smoothing": 0.25
    },
    "subtask": {
      "enabled": false,
      "workflow": "two_stage",
      "prefetch": true,
      "refresh_every_actions": 200,
      "minimum_lead_actions": 20
    },
    "timeouts": {
      "connect_s": 5.0,
      "request_s": 60.0,
      "load_s": 600.0,
      "release_s": 30.0
    }
  },
  "hot_reloadable": [
    "params.request_when_remaining",
    "params.fusion.trunk_mode",
    "params.fusion.trunk_smoothing",
    "params.fusion.max_smoothing_steps",
    "params.fusion.exponential_factor",
    "params.fusion.exponential_smoothing",
    "params.subtask.refresh_every_actions",
    "params.subtask.minimum_lead_actions"
  ]
}
